<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title>Signup</title>
</head>

<body>
    <div class="container">
     <nav>
      <a href="/">Home</a>
  <% if (currentUser) { %>
    <span>Hi, <%= currentUser.username %></span>
    <a href="/logout">Logout</a>
  <% } else { %>
    <a href="/login">Login</a>
    <a href="/signup">Signup</a>
  <% } %>
</nav>
<!--  Error message -->
 <% if (error) { %>
  <p style="color:red;"><%= error %></p>
<% } %>
<br/>
    <form method="POST">
        <input type="text" name="username" placeholder="Enter the username" required/><br/><br/>
        <input type="email" name="email" placeholder="Enter the Email" required/><br/><br/>
        <input type="password" name="password" placeholder="Enter the password" required/><br/><br/>
        <button type="submit">Signup</button>

    </form>
   </div> 
</body>
</html>